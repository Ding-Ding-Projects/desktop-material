{
  "manifest_version": 3,
  "name": "Desktop Material download handoff",
  "version": "0.1.0",
  "description": "Send an explicitly chosen web download to Desktop Material.",
  "permissions": ["contextMenus", "nativeMessaging", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Desktop Material download handoff"
  }
}
