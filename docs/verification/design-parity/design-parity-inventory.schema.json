{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desktop-material.invalid/schemas/design-parity-inventory-v1.json",
  "title": "Desktop Material fail-closed design-parity evidence inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureOnly", "inventoryId", "routeCatalogSha256", "expectedReferenceRouteCount", "referenceRoutes", "unreachableStates", "screens"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "fixtureOnly": { "type": "boolean" },
    "inventoryId": { "$ref": "#/$defs/id" },
    "routeCatalogSha256": { "$ref": "#/$defs/sha256" },
    "expectedReferenceRouteCount": { "type": "integer", "minimum": 1, "maximum": 500 },
    "referenceRoutes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/route" }
    },
    "unreachableStates": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reviewedUnreachable" }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/screen" }
    }
  },
  "$defs": {
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "captureTuple", "material3Audit", "evidence", "intentionalDeviations"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "captureTuple": { "$ref": "#/$defs/captureTuple" },
        "material3Audit": { "$ref": "#/$defs/material3Audit" },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["referenceCapture", "productionCapture", "comparison", "visualDiffReceipt"],
          "properties": {
            "referenceCapture": { "$ref": "#/$defs/artifact" },
            "productionCapture": { "$ref": "#/$defs/artifact" },
            "comparison": { "$ref": "#/$defs/artifact" },
            "visualDiffReceipt": { "$ref": "#/$defs/artifact" }
          }
        },
        "intentionalDeviations": {
          "type": "array",
          "maxItems": 500,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/deviation" }
        }
      }
    },
    "captureTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceFile", "referenceRoute", "productionRoute", "state", "theme", "viewportWidth", "viewportHeight", "scale"],
      "properties": {
        "referenceFile": { "$ref": "#/$defs/relativePath" },
        "referenceRoute": { "$ref": "#/$defs/id" },
        "productionRoute": { "$ref": "#/$defs/id" },
        "state": { "$ref": "#/$defs/id" },
        "theme": { "enum": ["light", "dark"] },
        "viewportWidth": { "type": "integer", "minimum": 160, "maximum": 8192 },
        "viewportHeight": { "type": "integer", "minimum": 160, "maximum": 8192 },
        "scale": { "type": "number", "minimum": 0.5, "maximum": 4 }
      }
    },
    "material3Audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewedBy", "reviewedAt", "controls"],
      "properties": {
        "status": { "const": "pass" },
        "reviewedBy": { "$ref": "#/$defs/id" },
        "reviewedAt": { "$ref": "#/$defs/timestamp" },
        "controls": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["category", "primitive", "status", "notes"],
            "properties": {
              "category": { "enum": ["buttons", "fields", "menus", "tabs", "dialogs", "navigation", "switches", "selection-controls", "typography", "shape", "elevation", "state-layers", "motion"] },
              "primitive": { "$ref": "#/$defs/id" },
              "status": { "const": "pass" },
              "notes": { "type": "string", "minLength": 1, "maxLength": 1024 }
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason", "approvedBy", "approvedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "approvedBy": { "$ref": "#/$defs/id" },
        "approvedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "referenceFile", "referenceRoute"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "referenceFile": { "$ref": "#/$defs/relativePath" },
        "referenceRoute": { "$ref": "#/$defs/id" }
      }
    },
    "reviewedUnreachable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "referenceFile", "referenceRoute", "reason", "reviewedBy", "reviewedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "referenceFile": { "$ref": "#/$defs/relativePath" },
        "referenceRoute": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "reviewedBy": { "$ref": "#/$defs/id" },
        "reviewedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
