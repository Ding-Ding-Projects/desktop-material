{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desktop-material.invalid/schemas/design-parity-route-catalog-v1.json",
  "title": "Desktop Material hand-written design-reference route catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogId",
    "expectedReachableRouteCount",
    "routes",
    "unreachableStates"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogId": { "$ref": "#/$defs/id" },
    "expectedReachableRouteCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/route" }
    },
    "unreachableStates": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/unreachable" }
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "referenceFile", "referenceRoute"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "referenceFile": { "$ref": "#/$defs/relativePath" },
        "referenceRoute": { "$ref": "#/$defs/id" }
      }
    },
    "unreachable": {
      "allOf": [
        { "$ref": "#/$defs/route" },
        {
          "type": "object",
          "required": ["reason"],
          "properties": {
            "reason": { "type": "string", "minLength": 1, "maxLength": 2048 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+$"
    }
  }
}
