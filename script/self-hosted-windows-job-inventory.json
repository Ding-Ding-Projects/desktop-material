{
  "version": 2,
  "releaseBootstrapComponents": [
    ".github/scripts/ensure-windows-git-bash.ps1",
    ".github/scripts/ensure-github-cli.sh",
    ".github/scripts/ensure-jq.sh"
  ],
  "jobs": [
    {
      "workflow": ".github/workflows/ci-windows.yml",
      "job": "build",
      "dependencyInventory": "docs/features/integrations/self-hosted-windows-dependency-bootstrap.md",
      "bootstrap": ".github/actions/setup-ci-environment/action.yml",
      "coldBootstrapTest": ".github/scripts/test-windows-release-bootstrap.ps1"
    },
    {
      "workflow": ".github/workflows/ci-windows.yml",
      "job": "e2e-smoke",
      "dependencyInventory": "docs/features/integrations/self-hosted-windows-dependency-bootstrap.md",
      "bootstrap": ".github/actions/setup-ci-environment/action.yml",
      "coldBootstrapTest": ".github/scripts/test-windows-release-bootstrap.ps1"
    }
  ]
}
